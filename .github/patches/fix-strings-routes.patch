+    `a.exports=JSON.parse('{"2L/ygS":[[1,"percent"]," percent complete"],"xb78ZZ":["checked"],"q1w2e3":["It\\'s ok \\\\\\\\o/"]}')`,
+    out,
+  );
+  assert.equal(out['2L/ygS'], '{percent} percent complete');
+  assert.equal(out.xb78ZZ, 'checked');
+  assert.equal(out.q1w2e3, "It's ok \\o/");
+});
